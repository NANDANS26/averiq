# =============================================================================
# Averiq — Environment Variable Reference
#
# Copy this file to .env and fill in the values for your environment.
# The setup script will do this automatically if .env does not exist.
#
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# PostgreSQL async connection string (asyncpg driver)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://averiq:averiq@localhost:5432/averiq

# Synchronous URL used by Alembic migrations only
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_SYNC_URL=postgresql+psycopg2://averiq:averiq@localhost:5432/averiq

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------

# Redis connection URL (used as Celery broker and result backend)
REDIS_URL=redis://localhost:6379/0

# Celery broker URL (defaults to REDIS_URL if not set)
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend URL
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---------------------------------------------------------------------------
# Application security
# ---------------------------------------------------------------------------

# Secret key used for:
#   - Application-level encryption of merchant webhook secrets (AES-256-GCM)
#   - JWT signing key (via python-jose)
# Must be a cryptographically random string of at least 32 bytes.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=CHANGE_ME_generate_a_random_32_byte_hex_string

# JWT access token expiry in seconds (default: 3600 = 1 hour)
TOKEN_EXPIRY_SECONDS=3600

# JWT refresh token expiry in seconds (default: 604800 = 7 days)
REFRESH_TOKEN_EXPIRY_SECONDS=604800

# Allowed CORS origins (comma-separated list, no wildcards with credentials)
ALLOWED_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Webhook ingestion
# ---------------------------------------------------------------------------

# Maximum webhooks allowed per merchant per minute before HTTP 429.
# Default is conservative to avoid throttling legitimate Razorpay bursts.
# Valid range: 1–10000
WEBHOOK_RATE_LIMIT_PER_MINUTE=300

# When true, stores the raw webhook body bytes in webhook_raw_payloads.
# Requires the webhook_raw_payloads table (migration 002).
# WARNING: may store PII; ensure retention policy is applied.
# Valid values: true | false
WEBHOOK_RETAIN_RAW_PAYLOAD=false

# Retention window in days for raw webhook payloads (only used when above is true)
WEBHOOK_RAW_PAYLOAD_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# AI / LLM provider
# ---------------------------------------------------------------------------

# AI provider to use for failure diagnosis.
# Valid values: stub | external_llm
# Use "stub" for local development and CI; "external_llm" for production.
AI_PROVIDER=stub

# Timeout in seconds for external LLM API calls
# Default: 10 — after this the deterministic fallback classifier is used
AI_RESPONSE_TIMEOUT_SECONDS=10

# LLM API base URL (only required when AI_PROVIDER=external_llm)
LLM_API_BASE_URL=

# LLM API key (only required when AI_PROVIDER=external_llm)
LLM_API_KEY=

# LLM model name to use for diagnosis (only required when AI_PROVIDER=external_llm)
LLM_MODEL_NAME=

# ---------------------------------------------------------------------------
# Recoverability model
# ---------------------------------------------------------------------------

# Minimum recoverability probability required before an intervention
# can be approved by the Policy Engine (confidence threshold).
# Valid range: 0.0–1.0
RECOVERABILITY_THRESHOLD=0.5

# ---------------------------------------------------------------------------
# Synthetic dataset and training
# ---------------------------------------------------------------------------

# Number of synthetic cases to generate for training.
# Default: 50000 (recommended evaluation range: 50000–250000)
# Smoke tests and local dev: 100–1000 is sufficient
# Valid range: 100–250000
DATASET_SIZE=50000

# Random seed for reproducible dataset generation and model training
RANDOM_SEED=42

# ---------------------------------------------------------------------------
# Model evaluation quality gates
# ---------------------------------------------------------------------------

# Emit a structured warning when the LightGBM Brier score exceeds this threshold.
# Default: 0.25 (a well-calibrated model should score well below this)
# Configurable so that gate stringency can be adjusted per environment.
BRIER_SCORE_WARNING_THRESHOLD=0.25

# ---------------------------------------------------------------------------
# Attribution engine
# ---------------------------------------------------------------------------

# Attribution window in seconds.
# Recoveries within this window after an Averiq intervention are classified
# as DIRECT_INTERVENTION. Recoveries outside it are ORGANIC.
# Default: 86400 (24 hours)
ATTRIBUTION_WINDOW_SECONDS=86400

# ---------------------------------------------------------------------------
# Gateway / Razorpay
# ---------------------------------------------------------------------------

# Operating mode for all gateway calls.
# SIMULATED  — use FakeRazorpayGateway; no real API calls; safe for local dev
# REAL_TEST_MODE — use Razorpay test-mode APIs; requires valid test credentials
#
# NOTE: SIMULATED must be used for all CI and demo scenarios to respect the
# 30 Payment Link test-mode limit on Razorpay test accounts.
OPERATING_MODE=SIMULATED

# Razorpay test-mode credentials (only required when OPERATING_MODE=REAL_TEST_MODE)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Timeout in seconds for external gateway API calls
GATEWAY_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Failure Lab
# ---------------------------------------------------------------------------

# When true, exposes POST /api/v1/simulation/failures/* endpoints.
# MUST be false in any environment that touches real payment data.
# Valid values: true | false
ENABLE_FAILURE_LAB=false

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Log level for structured JSON output
# Valid values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# OpenTelemetry collector endpoint (optional; only used with observability profile)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Latency threshold in milliseconds — log a structured warning when exceeded
OPERATION_LATENCY_WARNING_MS=500

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------

# Backend API base URL (used by Vite dev server proxy and production build)
VITE_API_BASE_URL=http://localhost:8000
