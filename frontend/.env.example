# Averiq Frontend Environment Variables
# Copy to .env.local for local development (never commit .env.local)

# Backend API base URL (used by the Vite dev proxy; override for production builds)
# Default: /api/v1  (proxied to localhost:8000 by vite.config.ts in dev)
VITE_API_BASE_URL=/api/v1

# App version (optional; displayed in footer/about)
VITE_APP_VERSION=0.1.0
